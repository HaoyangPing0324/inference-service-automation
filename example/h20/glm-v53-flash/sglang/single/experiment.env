# 结构示例，不是可直接提交的机器配置；/srv与single-node均为示意值。
# 官方引用版本/访问日期等须新任务重新查证；空日期故意阻止正式验收。
#!/usr/bin/env bash
# shellcheck shell=bash
# 这是由 experiment.toml、官方命令和运行布线生成的内部 Bash 协议，不是用户填写表。
# 设计调整先修改 experiment.toml，再由 AI 同步本文件；不要写凭据。

PROJECT_TITLE='h20_glm-v53-flash_sglang_single'
HARDWARE_TYPE='NVIDIA H20'
HARDWARE_ALIAS='h20'
MODEL_NAME='glm-v53-flash'
MODEL_PATH='/models/GLM/GLM-5.3-Flash'
SERVED_MODEL_NAME='glm-53-flash'
FRAMEWORK='sglang'
DEPLOYMENT='single'
WORKSPACE_DIR='/srv/inference'
REMOTE_PROJECT_DIR='/srv/inference/h20_glm-v53-flash_sglang_single'
HOST_MODELS_DIR='/srv/models'
CONTAINER_MODELS_DIR='/models'
OPERATIONS_COMMAND='nvidia-smi'
AVAILABLE_SSH_TARGETS=('single-node')

# 部署拓扑必须从官方教程的原始命令提取，再从候选机器中分配。
# 例：1P1D、每角色 TP4，可写为 SSH_TARGETS=(host-a host-b)、
# OFFICIAL_NODE_COUNT=2、HOST_DEVICE_COUNTS=(4 4)、DEVICE_COUNT=8。
SSH_TARGETS=('single-node')
OFFICIAL_NODE_COUNT=1
HOST_DEVICE_COUNTS=(8)
DEVICE_COUNT=8

# 官方证据。填入目标镜像/框架版本对应的页面或仓库源文件。
OFFICIAL_REFERENCE_URL='https://huggingface.co/zai-org/GLM-5.3-Flash'
OFFICIAL_REFERENCE_VERSION='Illustrative GLM-5.3-Flash archived arguments; runtime v0.5.21; not a newly verified official recipe'
OFFICIAL_REFERENCE_ACCESSED=''
PREFIX_CACHE_EVIDENCE='Example no-prefix design uses --disable-radix-cache; recheck target CLI before real execution'

# 容器。数组按 token 拆分；不要使用 eval。
CONTAINER_CLI=(docker)
IMAGE='lmsysorg/sglang:v0.5.21'
SERVER_CONTAINER_NAME="${PROJECT_TITLE}-server"
CLIENT_CONTAINER_NAME="${PROJECT_TITLE}-client"
SERVER_CONTAINER_ARGS=(
  run -d --name "$SERVER_CONTAINER_NAME"
  --runtime nvidia-container-runtime
  -e NVIDIA_VISIBLE_DEVICES=all -e NVIDIA_DRIVER_CAPABILITIES=all
  -p "$HOST_PORT:$SERVICE_PORT" --ipc=host
  -v "$HOST_MODELS_DIR:/models:ro"
  -v "$REMOTE_PROJECT_DIR/server:/server"
  -v "$REMOTE_PROJECT_DIR/client:/client"
  -v "$REMOTE_PROJECT_DIR/experiment.env:/experiment.env:ro"
  -w /server "$IMAGE" sleep infinity
)
CLIENT_CONTAINER_ARGS=(
  run -d --name "$CLIENT_CONTAINER_NAME" --network "container:$SERVER_CONTAINER_NAME"
  -v "$HOST_MODELS_DIR:/models:ro"
  -v /srv/datasets:/datasets:ro
  -v "$REMOTE_PROJECT_DIR/server:/server"
  -v "$REMOTE_PROJECT_DIR/client:/client"
  -v "$REMOTE_PROJECT_DIR/experiment.env:/experiment.env:ro"
  -w /client "$IMAGE" sleep infinity
)
# Linux host: server.sh nsys adds a read-only sysfs mount to the single-service
# container run command; it prepares the container, not the model launch itself.

# 端口和健康检查由官方教程确定，再做本地端口适配。
SERVICE_HOST='0.0.0.0'
SERVICE_PORT=30000
HOST_PORT=30080
HEALTH_PATH='/health'
HEALTH_TIMEOUT_SECONDS=900

# 服务命令。将官方命令中的每个显式 token 按原顺序放入数组。
SERVICE_CMD=(sglang serve)
SERVICE_ARGS=(
  --model-path "$MODEL_PATH" --served-model-name "$SERVED_MODEL_NAME"
  --tp-size 8 --ep-size 8 --mem-fraction-static 0.75
  --dsa-prefill-backend tilelang --dsa-decode-backend tilelang
  --kv-cache-dtype bfloat16 --moe-runner-backend deep_gemm
  --host "$SERVICE_HOST" --port "$SERVICE_PORT"
  --reasoning-parser auto --tool-call-parser auto
)

# 首轮必须 no-prefix。若框架默认关闭，设 DEFAULT_DISABLED=1 并保留证据；
# 否则填入目标版本验证过的禁用参数。其他服务参数不得偏离官方值。
PREFIX_CACHE_MODE='disabled'
PREFIX_CACHE_DEFAULT_DISABLED=0
PREFIX_CACHE_DISABLE_ARGS=(--disable-radix-cache)
PREFIX_CACHE_ENABLE_ARGS=()

# Benchmark 协议沿用 example；只有用户或当前任务明确要求时才修改。
ISL=16384
OSL=2048
CONCURRENCIES=(1 2 4 8 16 32)
# Keep the full baseline; benchmark_test.sh tuning selects 1/8/32 for that run only.
REQUEST_MULTIPLIER=5
WARMUP_REQUESTS=2
SEED_BASE=20260923
DATASET_PATH='/datasets/ShareGPT_Vicuna_unfiltered/ShareGPT_V3_unfiltered_cleaned_split.json'
RESULT_NAME_PREFIX="${MODEL_NAME}_${FRAMEWORK}"
BENCHMARK_CMD=(python3 -m sglang.benchmark.serving)
BENCHMARK_BASE_ARGS=(
  --backend sglang --host 127.0.0.1 --port "$SERVICE_PORT"
  --model "$MODEL_PATH" --served-model-name "$SERVED_MODEL_NAME"
  --tokenizer "$MODEL_PATH" --dataset-name random
  --random-range-ratio 1.0 --request-rate inf --flush-cache --output-details
)
BENCHMARK_INPUT_LEN_FLAG='--random-input-len'
BENCHMARK_OUTPUT_LEN_FLAG='--random-output-len'
BENCHMARK_WARMUP_FLAG='--warmup-requests'
BENCHMARK_NUM_PROMPTS_FLAG='--num-prompts'
BENCHMARK_CONCURRENCY_FLAG='--max-concurrency'
BENCHMARK_SEED_FLAG='--seed'
BENCHMARK_OUTPUT_FILE_FLAG='--output-file'
BENCHMARK_DATASET_PATH_FLAG='--dataset-path'

# Profiling。SGLang 示例使用的值保留为默认采集协议，兼容性必须按目标版本确认。
PROFILE_TP_SIZE=8
# Default native continuous capture; legacy step settings below apply only to protocol=steps.
PROFILE_PROTOCOL='time'
PROFILE_PRERUN_SECONDS=0
PROFILE_PRERUN_COMPLETED_MULTIPLIER=4
PROFILE_POSTRUN_COMPLETED_MULTIPLIER=1
PROFILE_CAPTURE_SECONDS=15
PROFILE_MAX_REQUESTS=100000
PROFILE_PREFILL_SCOPE='steps'
PROFILE_PREFILL_STEPS=4
PROFILE_REQUEST_MULTIPLIER=5
PROFILE_PRERUN_MULTIPLIER=4
PROFILE_DECODE_STEPS=128
PROFILE_PREFIX="${MODEL_NAME}-time"
PROFILE_MANAGER_MODULE='sglang.srt.managers.scheduler_components.profiler_manager'
PROFILE_HOOK_MODULE='glm_decode_window'
PROFILE_HOOK_ENABLED=0
# Set to 1 only after the user approves the single-service stage-target adapter.
PROFILE_SINGLE_STAGE_ADAPTER_APPROVED=0
PROFILE_FRAMEWORK_ENV=(SGLANG_PROFILE_V2=0)
PROFILE_COMMON_ARGS=(--profile --profile-by-stage)
PROFILE_PREFIX_FLAG='--profile-prefix'
PROFILE_ACTIVITIES_FLAG='--profile-activities'
PROFILE_OUTPUT_DIR_FLAG='--profile-output-dir'
PROFILE_TORCH_ACTIVITIES=(CPU GPU)
PROFILE_NSYS_ACTIVITIES=(CUDA_PROFILER)
PROFILE_REQUEST_BODY_FLAG='--extra-request-body'

# Nsys 包装参数来自 example；仅在 NVIDIA 平台且目标版本支持时使用。
NSYS_BIN='nsys'
NSYS_PROFILE_ARGS=(
  --trace=cuda,nvtx,osrt
  --sample=none
  --cpuctxsw=none
  --resolve-symbols=false
  --trace-fork-before-exec=true
  --cuda-graph-trace=node
  --capture-range=cudaProfilerApi
  --capture-range-end=repeat:sync
  --kill=none
)
