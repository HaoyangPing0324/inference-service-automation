#!/usr/bin/env bash
# shellcheck shell=bash
# 这是由 experiment.toml、官方命令和运行布线生成的内部 Bash 协议，不是用户填写表。
# 设计调整先修改 experiment.toml，再由 AI 同步本文件；不要写凭据。

PROJECT_TITLE='h20_deepseek-v4-flash_sglang_pd-aggregation'
HARDWARE_TYPE='NVIDIA H20'
HARDWARE_ALIAS='h20'
MODEL_NAME='deepseek-v4-flash'
MODEL_PATH='/models/Deepseek/DeepSeek-V4-Flash-0731'
SERVED_MODEL_NAME='deepseek-v4-flash'
FRAMEWORK='sglang'
DEPLOYMENT='pd-aggregation'
WORKSPACE_DIR='/srv/inference'
REMOTE_PROJECT_DIR='/srv/inference/h20_deepseek-v4-flash_sglang_pd-aggregation'
HOST_MODELS_DIR='/srv/models'
CONTAINER_MODELS_DIR='/models'
HOST_DATASETS_DIR='/srv/datasets'
CONTAINER_DATASETS_DIR='/datasets'
OPERATIONS_COMMAND='nvidia-smi'
AVAILABLE_SSH_TARGETS=('prefill-node' 'decode-node')
SSH_GATEWAY=''

SSH_TARGETS=('prefill-node' 'decode-node')
OFFICIAL_NODE_COUNT=2
HOST_DEVICE_COUNTS=(4 4)
DEVICE_COUNT=8
PREFILL_SSH_TARGET='prefill-node'
PREFILL_HOST='prefill.example.invalid'
PREFILL_GPU_IDS='4,5,6,7'
PREFILL_PORT=30000
DECODE_SSH_TARGET='decode-node'
DECODE_HOST='decode.example.invalid'
DECODE_GPU_IDS='0,1,2,3'
DECODE_PORT=30080
ROUTER_SSH_TARGET='prefill-node'
ROUTER_HOST='0.0.0.0'
ROUTER_PORT=8000
PD_TRANSFER_BACKEND='mooncake'
PD_IB_DEVICES='mlx5_0,mlx5_1,mlx5_2,mlx5_3,mlx5_4'

# 官方证据。填入目标镜像/框架版本对应的页面或仓库源文件。
OFFICIAL_REFERENCE_URL='https://huggingface.co/deepseek-ai/DeepSeek-V4-Flash-0731; https://github.com/sgl-project/sglang/blob/main/docs/src/snippets/configs/deepseek-ai/deepseek-v4.jsx; https://github.com/sgl-project/sglang/blob/main/docs/docs/advanced_features/pd_disaggregation.mdx'
OFFICIAL_REFERENCE_VERSION='DeepSeek-V4-Flash-0731 model card bundled with local checkpoint; sglang main@3b72b70ef4afb3b2fd670b34f93b189000ad28bb; runtime v0.5.21'
OFFICIAL_REFERENCE_ACCESSED='2026-10-14'
PREFIX_CACHE_EVIDENCE='Installed lmsysorg/sglang:v0.5.21 CLI help exposes --disable-radix-cache; verified 2026-10-14.'

# 容器。数组按 token 拆分；不要使用 eval。
CONTAINER_CLI=(docker)
IMAGE='lmsysorg/sglang:v0.5.21'
PREFILL_CONTAINER_NAME="${PROJECT_TITLE}-prefill"
DECODE_CONTAINER_NAME="${PROJECT_TITLE}-decode"
ROUTER_CONTAINER_NAME="${PROJECT_TITLE}-router"
SERVER_CONTAINER_NAME="$PREFILL_CONTAINER_NAME"
CLIENT_CONTAINER_NAME="${PROJECT_TITLE}-client"
SERVER_CONTAINER_ARGS=(
  --runtime nvidia-container-runtime
  -e NVIDIA_VISIBLE_DEVICES=all
  -e NVIDIA_DRIVER_CAPABILITIES=all
  --network host
  --ipc=host
  --shm-size 32g
  -v /dev/infiniband:/dev/infiniband
  -v /sys:/sys:ro
)
CLIENT_CONTAINER_ARGS=(
  --network host
  -v "$HOST_DATASETS_DIR:$CONTAINER_DATASETS_DIR:ro"
)

# 端口和健康检查由官方教程确定，再做本地端口适配。
SERVICE_HOST='0.0.0.0'
SERVICE_PORT=8000
HOST_PORT=8000
HEALTH_PATH='/health'
HEALTH_TIMEOUT_SECONDS=1800

# 服务命令。将官方命令中的每个显式 token 按原顺序放入数组。
SERVICE_ENV=()
SERVICE_CMD=(sglang serve)
SERVICE_ARGS=(
  --trust-remote-code
  --model-path "$MODEL_PATH"
  --served-model-name "$SERVED_MODEL_NAME"
  --tp 4
  --moe-runner-backend flashinfer_mxfp4
  --speculative-algorithm DSPARK
  --chunked-prefill-size 4096
  --swa-full-tokens-ratio 0.1
)
PREFILL_SERVICE_ARGS=(--mem-fraction-static 0.90)
DECODE_SERVICE_ARGS=(--mem-fraction-static 0.80)
ROUTER_CMD=(python3 -m sglang_router.launch_router)
ROUTER_ARGS=(
  --pd-disaggregation
  --prefill "http://${PREFILL_HOST}:${PREFILL_PORT}"
  --decode "http://${DECODE_HOST}:${DECODE_PORT}"
  --host "$ROUTER_HOST"
  --port "$ROUTER_PORT"
)

# 首轮必须 no-prefix。若框架默认关闭，设 DEFAULT_DISABLED=1 并保留证据；
# 否则填入目标版本验证过的禁用参数。其他服务参数不得偏离官方值。
PREFIX_CACHE_MODE='disabled'
PREFIX_CACHE_DEFAULT_DISABLED=0
PREFIX_CACHE_DISABLE_ARGS=(--disable-radix-cache)
PREFIX_CACHE_ENABLE_ARGS=()

# Benchmark 协议沿用 example；只有用户或当前任务明确要求时才修改。
ISL=16384
OSL=2048
CONCURRENCIES=(1 2 4 8 16 32)
REQUEST_MULTIPLIER=5
WARMUP_REQUESTS=2
SEED_BASE=20260923
DATASET_PATH='/datasets/ShareGPT_Vicuna_unfiltered/ShareGPT_V3_unfiltered_cleaned_split.json'
RESULT_NAME_PREFIX="${MODEL_NAME}_${FRAMEWORK}"
BENCHMARK_CMD=(python3 -m sglang.bench_serving)
BENCHMARK_BASE_ARGS=(
  --backend sglang
  --host 127.0.0.1
  --port "$SERVICE_PORT"
  --model "$MODEL_PATH"
  --served-model-name "$SERVED_MODEL_NAME"
  --tokenizer "$MODEL_PATH"
  --dataset-name random
  --random-range-ratio 1.0
  --flush-cache
)
BENCHMARK_INPUT_LEN_FLAG='--random-input-len'
BENCHMARK_OUTPUT_LEN_FLAG='--random-output-len'
BENCHMARK_WARMUP_FLAG='--warmup-requests'
BENCHMARK_NUM_PROMPTS_FLAG='--num-prompts'
BENCHMARK_CONCURRENCY_FLAG='--max-concurrency'
BENCHMARK_SEED_FLAG='--seed'
BENCHMARK_OUTPUT_FILE_FLAG='--output-file'
BENCHMARK_DATASET_PATH_FLAG='--dataset-path'

# Profiling。SGLang 示例使用的值保留为默认采集协议，兼容性必须按目标版本确认。
PROFILE_TP_SIZE=4
# Default native continuous capture; legacy step settings below apply only to protocol=steps.
PROFILE_PROTOCOL='time'
PROFILE_PRERUN_SECONDS=0
PROFILE_PRERUN_COMPLETED_MULTIPLIER=4
PROFILE_POSTRUN_COMPLETED_MULTIPLIER=1
PROFILE_CAPTURE_SECONDS=15
PROFILE_MAX_REQUESTS=100000
PROFILE_PREFILL_SCOPE='steps'
PROFILE_PREFILL_STEPS=4
PROFILE_REQUEST_MULTIPLIER=5
PROFILE_PRERUN_MULTIPLIER=4
PROFILE_DECODE_STEPS=128
PROFILE_LOCAL_ROLE='prefill'
PROFILE_CAPTURE_ROLES=(prefill decode)
PROFILE_PREFIX="${MODEL_NAME}-time"
PROFILE_MANAGER_MODULE='sglang.srt.managers.scheduler_components.profiler_manager'
PROFILE_HOOK_MODULE='deepseek_decode_window'
PROFILE_HOOK_ENABLED=0
PROFILE_FRAMEWORK_ENV=(SGLANG_PROFILE_V2=0)
PROFILE_COMMON_ARGS=(--profile --profile-by-stage)
PROFILE_PD_SEPARATED=1
PROFILE_PD_SEPARATED_FLAG='--pd-separated'
PROFILE_PREFILL_URL_FLAG='--profile-prefill-url'
PROFILE_DECODE_URL_FLAG='--profile-decode-url'
PROFILE_PREFILL_URLS=("http://${PREFILL_HOST}:${PREFILL_PORT}")
PROFILE_DECODE_URLS=("http://${DECODE_HOST}:${DECODE_PORT}")
PROFILE_PREFIX_FLAG='--profile-prefix'
PROFILE_ACTIVITIES_FLAG='--profile-activities'
PROFILE_OUTPUT_DIR_FLAG='--profile-output-dir'
PROFILE_TORCH_ACTIVITIES=(CPU GPU)
PROFILE_NSYS_ACTIVITIES=(CUDA_PROFILER)
PROFILE_REQUEST_BODY_FLAG='--extra-request-body'

# Nsys 包装参数来自 example；仅在 NVIDIA 平台且目标版本支持时使用。
NSYS_BIN='nsys'
NSYS_PROFILE_ARGS=(
  --trace=cuda,nvtx,osrt
  --sample=none
  --cpuctxsw=none
  --resolve-symbols=false
  --trace-fork-before-exec=true
  --cuda-graph-trace=node
  --capture-range=cudaProfilerApi
  --capture-range-end=repeat:sync
  --kill=none
)
